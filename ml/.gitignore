# --------------------------------------------------------------------------
# ml/.gitignore  -  patterns are relative to the ml/ folder.
# --------------------------------------------------------------------------

# Raw data is WRITE-ONCE and fully reproducible via src/download.py +
# data/raw/SOURCES.md, so it is never committed.
# NOTE: "data/raw/*" (not "data/raw/") is required so the negation below works;
# git cannot re-include a file whose parent directory is itself excluded.
data/raw/*
!data/raw/SOURCES.md

# Everything in processed/ is regenerated by src/clean.py + src/features.py.
data/processed/

# Python environment
.venv/
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Model artefacts: no model file over 50 MB may be committed.
# Git has no size-based ignore rule, so the formats below - which are the ones
# that realistically exceed 50 MB - are excluded wholesale. Small scikit-learn
# artefacts (models/*.joblib) stay tracked so teammates can run src/predict.py
# without retraining; check their size before committing.
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.ckpt
*.pb
*.safetensors
models/**/*.bin
