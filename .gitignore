# Ignore the Python virtual environment
venv/
**/venv/

# Ignore Python bytecode and cache files
__pycache__/
**/.pyc

# Ignore the SQLite database file
# The database should be generated by scripts, not committed
*.db
sql_app.db

# Ignore executables and specific tool files
*.exe
ngrok
ngrok.exe

# Ignore user-specific IDE settings
.vscode/
.idea/

# Flutter cache & build outputs
.dart_tool/
build/
.packages
.flutter-plugins
.flutter-plugins-dependencies